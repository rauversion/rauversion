<%= t(".greeting", recipient: @recipient_name) %>

<%= t(".intro", actor: @actor_name, event: @proposal.event_name) %>

<%= t(".proposal_details") %>

<%= t(".service") %>: <%= @service.title %>
<%= t(".date") %>: <%= @event_date %>
<%= t(".venue") %>: <%= [@proposal.venue_name, @proposal.city, @proposal.country].compact_blank.join(", ") %>
<%= t(".amount") %>: <%= formatted_product_price(@proposal.proposed_amount, @proposal.currency) %>

<%= t(".view_proposal") %>: <%= @proposal_url %>

<%= t(".action_required") %>
