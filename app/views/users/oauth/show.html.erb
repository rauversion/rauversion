<% provider = params[:provider] %>
<% provider_name = { "google_oauth2" => "Google", "discord" => "Discord", "twitch" => "Twitch", "zoom" => "Zoom", "stripe_connect" => "Stripe", "mercado_pago" => "Mercado Pago" }.fetch(provider, provider.humanize) %>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="dark bg-[#0b0d0c]">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark">
    <title><%= t("oauth.redirect.title", provider: provider_name) %> · Rauversion</title>
    <%= favicon_link_tag "logo.png" %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Host+Grotesk:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  </head>
  <body class="flex min-h-screen min-h-svh flex-col bg-[#0b0d0c] bg-[radial-gradient(ellipse_at_50%_42%,#1e281b80_0%,transparent_55%)] font-sans text-[#f5f6f2] antialiased">
    <header class="flex items-center gap-2.5 px-10 py-7 text-[21px] font-[650] tracking-[-0.8px] max-[480px]:px-6 max-[480px]:py-5 max-[480px]:text-[19px]">
      <%= image_tag "logo-dark.png", alt: "", width: 36, height: 36, class: "size-9 object-contain mix-blend-screen max-[480px]:size-[30px]" %>
      <span>rauversion</span>
    </header>

    <main class="grid flex-1 grid-cols-1 place-items-center px-6 pt-10 pb-16 max-[480px]:pt-7 max-[480px]:pb-10" aria-labelledby="oauth-title">
      <div class="w-full min-w-0 max-w-[420px] text-center">
        <p class="mb-6 flex items-center justify-center gap-[9px] text-[11px] font-semibold tracking-[2px] text-[#c4ed93] uppercase"><span class="size-1.5 rounded-full bg-current shadow-[0_0_14px_#c4ed9360]" aria-hidden="true"></span><%= t("oauth.redirect.eyebrow") %></p>
        <h1 id="oauth-title" class="mx-auto max-w-[400px] text-[clamp(36px,5vw,48px)] leading-[1.1] font-semibold tracking-[-2px] text-balance wrap-anywhere"><%= t("oauth.redirect.title", provider: provider_name) %><span class="text-[#c4ed93]">.</span></h1>
        <p class="mx-auto mt-[18px] max-w-[340px] text-[15px] leading-[1.65] text-[#a1a79f] wrap-anywhere"><%= t("oauth.redirect.description", tenant: @oauth_tenant.name) %></p>

        <div class="mt-10 mb-7 flex items-start justify-center gap-[25px] rounded-[20px] border border-white/5 bg-[linear-gradient(145deg,#ffffff05,#ffffff02)] px-6 pt-7 pb-[22px] max-[480px]:mt-8 max-[480px]:gap-3.5 max-[480px]:px-3" aria-hidden="true">
          <div class="flex w-25 min-w-0 flex-col items-center gap-3">
            <div class="grid size-17 place-items-center overflow-hidden rounded-[19px] border border-[#c4ed93]/18 bg-[#c4ed93]/6 text-3xl font-medium text-[#d6f5b4]">
              <% if @oauth_tenant.logo.attached? %>
                <%= image_tag @oauth_tenant.logo, alt: "", class: "size-full object-contain" %>
              <% else %>
                <span><%= @oauth_tenant.name.first.upcase %></span>
              <% end %>
            </div>
            <span class="max-w-full truncate text-xs leading-[1.5] text-[#bec3ba]"><%= @oauth_tenant.name %></span>
          </div>

          <div class="flex h-17 shrink-0 items-center gap-1 [&>span]:h-[7px] [&>span]:w-[3px] [&>span]:animate-oauth-signal [&>span]:rounded-full [&>span]:bg-[#c4ed93] [&>span]:opacity-40 motion-reduce:[&>span]:animate-none">
            <span></span><span class="[animation-delay:100ms]"></span><span class="[animation-delay:200ms] motion-reduce:h-[15px]!"></span><span class="[animation-delay:300ms] motion-reduce:h-6! motion-reduce:opacity-100!"></span><span class="[animation-delay:200ms] motion-reduce:h-[15px]!"></span><span class="[animation-delay:100ms]"></span><span></span>
          </div>

          <div class="flex w-25 min-w-0 flex-col items-center gap-3">
            <div class="grid size-17 place-items-center rounded-[19px] bg-[#f5f6f2] text-[#242823] shadow-[0_4px_18px_#00000020]">
              <%= render "provider_icon", provider: provider, provider_name: provider_name %>
            </div>
            <span class="max-w-full truncate text-xs leading-[1.5] text-[#bec3ba]"><%= provider_name %></span>
          </div>
        </div>

        <div class="mb-6 flex items-center justify-center gap-[9px] text-[13px] text-[#a1a79f]" role="status">
          <span class="size-[13px] animate-spin rounded-full border-[1.5px] border-[#c4ed93]/17 border-t-[#c4ed93] [animation-duration:900ms] motion-reduce:animate-none" aria-hidden="true"></span>
          <span><%= t("oauth.redirect.status", provider: provider_name) %></span>
        </div>

        <%= form_tag omniauth_authorize_path(:user, provider, tenant_oauth_context: params[:tenant_oauth_context]),
          method: :post, id: "tenant-oauth-form", data: { turbo: false } do %>
          <button type="submit" class="flex min-h-[52px] w-full cursor-pointer items-center justify-center gap-3 rounded-xl border border-white/9 bg-[#f0f2e9] px-5 py-3.5 text-sm font-semibold text-[#171b14] transition-[background-color,transform] duration-150 hover:bg-[#d6f5b4] focus-visible:outline-2 focus-visible:outline-offset-[5px] focus-visible:outline-[#c4ed93] active:translate-y-px motion-reduce:transition-none">
            <span><%= t("oauth.redirect.continue", provider: provider_name) %></span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
          </button>
        <% end %>

        <p class="mt-[15px] text-xs leading-[1.65] text-[#92998d]"><%= t("oauth.redirect.hint") %></p>
        <noscript><p class="mt-[15px] text-xs leading-[1.65] text-[#92998d]"><%= t("oauth.redirect.no_javascript") %></p></noscript>
      </div>
    </main>

    <footer class="flex items-center justify-center gap-2 p-6 text-center text-xs leading-[1.5] text-[#92998d]">
      <svg class="shrink-0" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
      <span><%= t("oauth.redirect.privacy", provider: provider_name) %></span>
    </footer>

    <script>
      window.requestAnimationFrame(function () {
        window.requestAnimationFrame(function () {
          document.getElementById("tenant-oauth-form").requestSubmit();
        });
      });
    </script>
  </body>
</html>
