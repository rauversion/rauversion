<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
  <h1 style="color:#2d3748;margin:0 0 24px;">
    <%= t(".greeting", recipient: @recipient.username) %>
  </h1>

  <p style="color:#4a5568;margin:0 0 16px;">
    <%= t(".cancellation_message", service: @service.title, cancelled_by: @cancelled_by_name) %>
  </p>

  <div style="background-color:#f7fafc;border:1px solid #e2e8f0;border-radius:8px;padding:16px;margin:24px 0;">
    <h2 style="color:#2d3748;font-size:18px;margin:0 0 16px;">
      <%= t(".booking_details") %>
    </h2>

    <table style="width:100%;border-collapse:collapse;color:#4a5568;font-size:14px;">
      <tr>
        <td style="padding:6px 0;font-weight:600;"><%= t(".service") %></td>
        <td style="padding:6px 0;text-align:right;"><%= @service.title %></td>
      </tr>
      <tr>
        <td style="padding:6px 0;font-weight:600;"><%= t(".provider") %></td>
        <td style="padding:6px 0;text-align:right;"><%= @provider.username %></td>
      </tr>
      <tr>
        <td style="padding:6px 0;font-weight:600;"><%= t(".customer") %></td>
        <td style="padding:6px 0;text-align:right;"><%= @customer.username %></td>
      </tr>
      <% if @service_booking.scheduled_date.present? || @service_booking.starts_at.present? %>
        <tr>
          <td style="padding:6px 0;font-weight:600;"><%= t(".date") %></td>
          <td style="padding:6px 0;text-align:right;">
            <%= @service_booking.scheduled_date.presence || I18n.l(@service_booking.starts_at.to_date, format: :long) %>
            <% if @service_booking.scheduled_time.present? %>
              · <%= @service_booking.scheduled_time %>
            <% end %>
          </td>
        </tr>
      <% end %>
      <% if @service_booking.cancellation_reason.present? %>
        <tr>
          <td style="padding:6px 0;font-weight:600;vertical-align:top;"><%= t(".reason") %></td>
          <td style="padding:6px 0;text-align:right;"><%= @service_booking.cancellation_reason %></td>
        </tr>
      <% end %>
    </table>
  </div>

  <p style="color:#4a5568;margin:0 0 16px;">
    <%= t(".refund_info") %>
  </p>

  <p style="margin:24px 0;">
    <%= link_to t(".view_booking_button"),
        @booking_url,
        style: "display:inline-block;background-color:#2d3748;color:white;padding:12px 18px;text-decoration:none;border-radius:6px;font-weight:600;" %>
  </p>
</div>
